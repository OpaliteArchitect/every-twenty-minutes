<Window
  x:Class="EveryTwentyMinutes.Views.MainTimer"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:EveryTwentyMinutes.ViewModels"
  Title="MainTimer"
  d:DesignHeight="450"
  d:DesignWidth="800"
  x:DataType="vm:MainTimerViewModel"
  mc:Ignorable="d">
  <Grid
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    RowDefinitions="*, *, *, *">
    <TextBlock
      Grid.Row="0"
      Grid.RowSpan="2"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      FontSize="60">
      Next break in
    </TextBlock>
    <TextBlock
      Grid.Row="2"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Text="{Binding MainTimer}" />
    <Button
      Grid.Row="3"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="Green">
      Start Timer
    </Button>
  </Grid>
</Window>
